{
  "name": "axiom-plugin-builder",
  "version": "1.0.0",
  "description": "MCP-callable governed plugin builder for AXIOM IDE / cognitive OS.",
  "type": "module",
  "main": "src/builder/index.js",
  "bin": {
    "axiom-plugin-builder": "./src/mcp/server.js"
  },
  "scripts": {
    "start": "node src/mcp/server.js",
