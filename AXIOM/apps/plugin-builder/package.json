  },
  "exports": {
    ".": "./src/builder/index.js",
    "./validator": "./src/validator.js",
    "./packager": "./src/packager.js",
    "./registry": "./src/registry.js",
    "./templates": "./src/builder/templates.js"
  },
  "keywords": [
    "axiom",
    "plugin",
    "mcp",
    "cognitive-os",
    "governance"
  ],
